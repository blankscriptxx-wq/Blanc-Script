# ── Database (Neon, via the Vercel–Neon integration) ──────────────
# Vercel injects these automatically once Neon is provisioned.
DATABASE_URL=

# ── Auth (Clerk) ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Storage (Cloudflare R2, S3-compatible) ───────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Background jobs (Trigger.dev) ─────────────────────────────────
TRIGGER_SECRET_KEY=

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=

# ── AI (Anthropic Claude) ─────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Marketing site (app/(site)) ──
# ── Blanc Script — environment variables ──────────────────────────────
# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://www.blancscript.com
# Analytics (see components/analytics/Analytics.tsx) — leave blank to disable
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# ── Enquiry form → email (Web3Forms, client-side) ──────────────────────
# Optional. The key is already set in components/forms/ContactForm.tsx; set
# this only if you want to override it without editing code. Public by design.
NEXT_PUBLIC_WEB3FORMS_KEY=

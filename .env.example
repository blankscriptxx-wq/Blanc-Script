# ── Blanc Script — environment variables ──────────────────────────────
# Copy to `.env.local` and fill in. Nothing here is required to run locally;
# all integrations are optional placeholders.

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://www.blancscript.com

# Analytics (see components/analytics/Analytics.tsx) — leave blank to disable
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Enquiry form → HubSpot (free CRM) ──────────────────────────────────
# From your HubSpot form's embed code (Marketing → Forms → your form → Share).
# Neither value is secret. See README → "Connecting the enquiry form to HubSpot".
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=

# ── Alternative: generic webhook (Zapier / Make / GoHighLevel) ──────────
# Only used if the HubSpot vars above are blank.
ENQUIRY_WEBHOOK_URL=

# ── Database (Neon, via the Vercel–Neon integration) ──────────────
# Vercel injects these automatically once Neon is provisioned.
DATABASE_URL=

# ── Auth (Clerk) ──────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Storage (Cloudflare R2, S3-compatible) ───────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── Background jobs (Trigger.dev) ─────────────────────────────────
TRIGGER_SECRET_KEY=

# ── Email (Resend) ────────────────────────────────────────────────
RESEND_API_KEY=

# ── AI (Anthropic Claude) ─────────────────────────────────────────
ANTHROPIC_API_KEY=

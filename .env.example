# ── Blanc Script — environment variables ──────────────────────────────
# Copy to `.env.local` and fill in. Nothing here is required to run locally;
# all integrations are optional placeholders.

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://www.blancscript.com

# Analytics (see components/analytics/Analytics.tsx) — leave blank to disable
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Enquiry form destination (see app/api/enquiry/route.ts)
# Point this at your CRM webhook (HubSpot / GoHighLevel / Zapier / Make) or leave blank.
ENQUIRY_WEBHOOK_URL=
